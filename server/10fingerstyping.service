[Unit]
Description=10fingerstyping API server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/10fingerstyping/server
Environment=DB_PATH=/opt/10fingerstyping/server/users.db
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/opt/10fingerstyping/venv/bin/python app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
